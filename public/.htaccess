# Airpack Ambalaj — statik Astro sitesi (LiteSpeed / Apache)
#
# DİKKAT: public_html içinde başka sitelerin (acilberber.com.tr, insaatustan.com.tr, toptansedir.com.tr…)
# klasörleri var ve bu dosyadaki ayarlar o sitelere de geçer. Bu yüzden:
# - DirectoryIndex'te index.php de bulunur (o sitelerin ana sayfaları için),
# - güvenlik ve önbellek başlıkları yalnızca airpackambalaj.com.tr için gönderilir (AIRPACK_SITE),
# - en alttaki cPanel PHP blokları korunur (insaatustan.com.tr PHP ayarlarını buradan alır).

Options -Indexes
DirectoryIndex index.html index.php
SetEnvIfNoCase Host "^(www\.)?airpackambalaj\.com\.tr(:[0-9]+)?$" AIRPACK_SITE
ErrorDocument 404 /404.html
ErrorDocument 410 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # www → www'siz ve HTTP → HTTPS, tek yönlendirmede
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Kaldırılan kopya ürün → aynı ebattaki ürün
  RewriteRule ^urun/15x40-cm-50li-havali-airpack-poset-2/?$ /urun/15x40-cm-50li-havali-airpack-poset/ [R=301,L]

  # Eski WordPress sitesinden kalan adresler: 410 (kalıcı olarak kaldırıldı), Google dizinden hızla düşürür.
  RewriteRule ^(wp-admin|wp-content|wp-includes|wp-json|etiket|hesabim|author|comments|product-category|product-tag)(/|$) - [G,L]
  RewriteRule ^(wp-login|xmlrpc|wp-cron|wp-signup|wp-trackback)\.php$ - [G,L]
  RewriteRule (^|/)feed/?$ - [G,L]
  RewriteRule ^([a-z_-]+-)?sitemap(_index)?\.xml$ - [G,L]
  RewriteCond %{QUERY_STRING} (^|&)(s|p|page_id|post_type|add-to-cart|product_cat)= [NC]
  RewriteRule ^ - [G,L]
</IfModule>

<IfModule mod_mime.c>
  AddType image/avif .avif
  AddType image/webp .webp
  AddType font/woff2 .woff2
  AddType application/json .json
</IfModule>

# Sıkıştırma (LiteSpeed Brotli'yi kendisi uygular; Apache için gzip)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/json application/javascript text/javascript image/svg+xml
</IfModule>

# Önbellek: /_astro/ altındaki JS, font ve görseller içerik hash'li adlarla üretilir; güvenle 1 yıl saklanabilir.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 1 hour"
  ExpiresByType application/xml "access plus 1 hour"
  ExpiresByType text/xml "access plus 1 hour"
  ExpiresByType text/plain "access plus 1 hour"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff" env=AIRPACK_SITE
  Header always set Referrer-Policy "strict-origin-when-cross-origin" env=AIRPACK_SITE
  Header always set X-Frame-Options "SAMEORIGIN" env=AIRPACK_SITE
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" env=AIRPACK_SITE
  # Tarayıcıya bir yıl boyunca yalnızca HTTPS kullanmasını söyler (alt alan adları hariç).
  Header always set Strict-Transport-Security "max-age=31536000" env=AIRPACK_SITE
  <FilesMatch "\.(js|woff2|webp|avif|jpe?g)$">
    Header set Cache-Control "public, max-age=31536000, immutable" env=AIRPACK_SITE
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache" env=AIRPACK_SITE
  </FilesMatch>
</IfModule>

# Aşağıdaki iki blok sunucudaki eski .htaccess'ten aynen alındı; alt klasördeki siteler (insaatustan.com.tr)
# PHP sürümünü ve ayarlarını buradan alıyor. cPanel › MultiPHP'de değişiklik yapılırsa buraya da işlenmeli,
# yoksa bir sonraki yayında üzerine yazılır.
# BEGIN cPanel-generated php ini directives, do not edit
# Manual editing of this file may result in unexpected behavior.
# To make changes to this file, use the cPanel MultiPHP INI Editor (Home >> Software >> MultiPHP INI Editor)
# For more information, read our documentation (https://go.cpanel.net/EA4ModifyINI)
<IfModule php8_module>
   php_flag display_errors On
   php_value max_execution_time 300
   php_value max_input_time 300
   php_value max_input_vars 3000
   php_value memory_limit 1024M
   php_value post_max_size 128M
   php_value session.gc_maxlifetime 1440
   php_value session.save_path "/var/cpanel/php/sessions/ea-php82"
   php_value upload_max_filesize 128M
   php_flag zlib.output_compression Off
</IfModule>
<IfModule lsapi_module>
   php_flag display_errors On
   php_value max_execution_time 300
   php_value max_input_time 300
   php_value max_input_vars 3000
   php_value memory_limit 1024M
   php_value post_max_size 128M
   php_value session.gc_maxlifetime 1440
   php_value session.save_path "/var/cpanel/php/sessions/ea-php82"
   php_value upload_max_filesize 128M
   php_flag zlib.output_compression Off
</IfModule>
# END cPanel-generated php ini directives, do not edit

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php82” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php82 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit

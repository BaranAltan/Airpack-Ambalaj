# Airpack Ambalaj — statik Astro sitesi (LiteSpeed / Apache)

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html
ErrorDocument 410 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # www → www'siz ve HTTP → HTTPS, tek yönlendirmede
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Kaldırılan kopya ürün → aynı ebattaki ürün
  RewriteRule ^urun/15x40-cm-50li-havali-airpack-poset-2/?$ /urun/15x40-cm-50li-havali-airpack-poset/ [R=301,L]

  # Eski WordPress sitesinden kalan adresler: 410 (kalıcı olarak kaldırıldı), Google dizinden hızla düşürür.
  RewriteRule ^(wp-admin|wp-content|wp-includes|wp-json|etiket|hesabim|author|comments|product-category|product-tag)(/|$) - [G,L]
  RewriteRule ^(wp-login|xmlrpc|wp-cron|wp-signup|wp-trackback)\.php$ - [G,L]
  RewriteRule (^|/)feed/?$ - [G,L]
  RewriteRule ^([a-z_-]+-)?sitemap(_index)?\.xml$ - [G,L]
  RewriteCond %{QUERY_STRING} (^|&)(s|p|page_id|post_type|add-to-cart|product_cat)= [NC]
  RewriteRule ^ - [G,L]
</IfModule>

<IfModule mod_mime.c>
  AddType image/avif .avif
  AddType image/webp .webp
  AddType font/woff2 .woff2
  AddType application/json .json
</IfModule>

# Sıkıştırma (LiteSpeed Brotli'yi kendisi uygular; Apache için gzip)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/json application/javascript text/javascript image/svg+xml
</IfModule>

# Önbellek: /_astro/ altındaki JS, font ve görseller içerik hash'li adlarla üretilir; güvenle 1 yıl saklanabilir.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 1 hour"
  ExpiresByType application/xml "access plus 1 hour"
  ExpiresByType text/xml "access plus 1 hour"
  ExpiresByType text/plain "access plus 1 hour"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  # Tarayıcıya bir yıl boyunca yalnızca HTTPS kullanmasını söyler (alt alan adları hariç).
  Header always set Strict-Transport-Security "max-age=31536000"
  <FilesMatch "\.(js|woff2|webp|avif|jpe?g)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

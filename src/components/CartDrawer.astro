---
import Icon from './Icon.astro';
---

<div class="ap-drawer-overlay" data-drawer-overlay></div>
<aside class="ap-cart-drawer" id="cart-drawer" aria-labelledby="cart-drawer-title" aria-hidden="true" data-drawer>
  <div class="ap-drawer-header">
    <h2 class="ap-drawer-title" id="cart-drawer-title">Sepetim <span data-drawer-count>(0)</span></h2>
    <button type="button" class="ap-drawer-close" data-close-drawer aria-label="Kapat">&times;</button>
  </div>

  <div class="ap-drawer-body">
    <div class="ap-cart-empty" data-drawer-empty>
      <div class="ap-empty-icon" aria-hidden="true">📦</div>
      <h3>Sepetiniz şu an boş.</h3>
      <p>İhtiyacınız olan ürünleri seçerek sepetinize ekleyebilirsiniz.</p>
    </div>
    <ul class="ap-cart-items-list" data-drawer-list></ul>
  </div>

  <div class="ap-drawer-footer" data-drawer-foot hidden>
    <div class="ap-subtotal-row">
      <span class="ap-subtotal-label">Ara Toplam</span>
      <span class="ap-subtotal-val" data-drawer-subtotal>₺0,00</span>
    </div>
    <div class="ap-shipping-note">Kargo ödeme adımında hesaplanır.</div>
    <a href="/sepet/" class="ap-checkout-btn">Sepete Git</a>
  </div>
</aside>

<p class="sr-only" aria-live="polite" data-cart-status></p>

<template id="tpl-drawer-line">
  <li class="ap-cart-item">
    <a data-link class="ap-item-img" tabindex="-1"><img data-thumb alt="" width="64" height="64" loading="lazy" /></a>
    <div class="ap-item-info">
      <a data-link class="ap-item-name" data-name></a>
      <div class="ap-item-pricing">
        <span class="ap-item-total" data-total></span>
        <span class="ap-item-unit" data-unit></span>
      </div>
      <span class="ap-bulk-tag-success" data-bulk-yes>✓ 1.000+ Adet Al İskontosu</span>
      <span class="ap-bulk-tag-hint" data-bulk-no>💡 İskontolu fiyat için <button type="button" data-action="bulk">1.000 adet yap</button></span>
      <div class="ap-item-actions">
        <div class="ap-item-counter">
          <button type="button" data-action="dec" aria-label="Azalt">−</button>
          <span data-qty-text></span>
          <button type="button" data-action="inc" aria-label="Artır">+</button>
        </div>
        <button type="button" class="ap-item-remove-btn" data-action="remove"><Icon name="trash-2" /></button>
      </div>
    </div>
  </li>
</template>


<script>
  import { formatNumber, formatTRY } from '../lib/pricing';
  import { cart } from '../scripts/cart';
  import { bindLineEvents, renderLines } from '../scripts/cart-ui';

  const drawer = document.querySelector<HTMLElement>('[data-drawer]')!;
  const overlay = document.querySelector<HTMLElement>('[data-drawer-overlay]')!;
  const list = drawer.querySelector<HTMLElement>('[data-drawer-list]')!;
  let lastFocus: Element | null = null;

  const render = () => {
    renderLines(list, 'tpl-drawer-line');
    const has = cart.items().length > 0;
    drawer.querySelector<HTMLElement>('[data-drawer-empty]')!.hidden = has;
    drawer.querySelector<HTMLElement>('[data-drawer-foot]')!.hidden = !has;
    drawer.querySelector('[data-drawer-count]')!.textContent = `(${formatNumber(cart.count())})`;
    drawer.querySelector('[data-drawer-subtotal]')!.textContent = formatTRY(cart.totals().subtotal);
  };

  const setOpen = (open: boolean) => {
    drawer.classList.toggle('open', open);
    overlay.classList.toggle('open', open);
    drawer.setAttribute('aria-hidden', String(!open));
    drawer.toggleAttribute('inert', !open);
    document.documentElement.classList.toggle('scroll-lock', open);
    if (open) {
      lastFocus = document.activeElement;
      drawer.querySelector<HTMLElement>('[data-close-drawer]')!.focus();
    } else if (lastFocus instanceof HTMLElement) {
      lastFocus.focus();
    }
  };

  drawer.setAttribute('inert', '');
  render();
  cart.onChange(render);
  bindLineEvents(list);

  window.addEventListener('cart:open', () => setOpen(true));
  drawer.querySelector('[data-close-drawer]')!.addEventListener('click', () => setOpen(false));
  overlay.addEventListener('click', () => setOpen(false));
  document.addEventListener('keydown', (e) => e.key === 'Escape' && drawer.classList.contains('open') && setOpen(false));

  // Sitedeki tüm "Sepete Ekle" butonları için tek dinleyici.
  document.addEventListener('click', (e) => {
    const btn = (e.target as Element).closest<HTMLElement>('[data-add-to-cart]');
    if (!btn) return;
    const { slug, name, price, thumb, qtyFrom, unit } = btn.dataset;
    if (!slug || !name || !price) return;
    const qtyInput = qtyFrom ? document.querySelector<HTMLInputElement>(qtyFrom) : null;
    const quantity = parseInt(qtyInput?.value ?? '', 10) || Number(btn.dataset.qty) || 50;
    cart.add({ slug, name, basePrice: Number(price), thumb, unit: unit === 'metre' ? 'metre' : 'adet' }, quantity);
    document.querySelector('[data-cart-status]')!.textContent = `${name} sepete eklendi.`;
    setOpen(true);
  });
</script>

<style>
  .ap-drawer-overlay {
    position: fixed;
    inset: 0;
    background: rgba(15, 23, 42, 0.45);
    z-index: 2998;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .ap-drawer-overlay.open {
    opacity: 1;
    pointer-events: auto;
  }

  :global(html.scroll-lock) {
    overflow: hidden;
  }

  .ap-cart-drawer {
    position: fixed;
    top: 0;
    right: 0;
    width: 100%;
    max-width: 400px;
    height: 100dvh;
    background: #ffffff;
    z-index: 2999;
    box-shadow: -4px 0 24px rgba(0, 0, 0, 0.15);
    transform: translateX(100%);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    display: flex;
    flex-direction: column;
  }

  .ap-cart-drawer.open {
    transform: translateX(0);
  }

  .ap-drawer-header {
    padding: 20px;
    border-bottom: 1px solid #e2e8f0;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .ap-drawer-title {
    margin: 0;
    font-size: 18px;
    font-weight: 800;
  }

  .ap-drawer-title span {
    font-size: 14px;
    font-weight: 600;
    color: #64748b;
  }

  .ap-drawer-close {
    font-size: 26px;
    line-height: 1;
    color: #94a3b8;
    padding: 0 4px;
  }

  .ap-drawer-close:hover {
    color: #ef4444;
  }

  .ap-drawer-body {
    flex-grow: 1;
    overflow-y: auto;
    padding: 20px;
  }

  .ap-cart-empty {
    text-align: center;
    padding: 40px 10px;
    color: #64748b;
  }

  .ap-empty-icon {
    font-size: 48px;
    opacity: 0.4;
    margin-bottom: 12px;
  }

  .ap-cart-empty h3 {
    margin: 0 0 6px;
    font-size: 16px;
  }

  .ap-cart-empty p {
    font-size: 13px;
    margin: 0;
  }

  .ap-cart-item {
    display: flex;
    gap: 12px;
    padding-bottom: 16px;
    margin-bottom: 16px;
    border-bottom: 1px solid #f1f5f9;
    align-items: flex-start;
  }

  .ap-item-img {
    width: 64px;
    height: 64px;
    background: #f8fafc;
    border-radius: 8px;
    border: 1px solid #e2e8f0;
    flex-shrink: 0;
    overflow: hidden;
  }

  .ap-item-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ap-item-info {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .ap-item-name {
    font-size: 14px;
    font-weight: 700;
    color: #0f172a;
    margin: 0 0 4px;
    line-height: 1.3;
  }

  .ap-item-name:hover {
    color: var(--primary);
  }

  .ap-item-pricing {
    display: flex;
    align-items: baseline;
    gap: 6px;
    margin-bottom: 6px;
  }

  .ap-item-total {
    font-size: 15px;
    font-weight: 800;
    color: #2563eb;
  }

  .ap-item-unit {
    font-size: 12px;
    color: #64748b;
  }

  .ap-bulk-tag-success {
    display: inline-block;
    font-size: 12px;
    font-weight: 700;
    color: #15803d;
    background: #f0fdf4;
    border: 1px solid #bbf7d0;
    padding: 2px 6px;
    border-radius: 4px;
    margin-bottom: 8px;
  }

  .ap-bulk-tag-hint {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 12px;
    font-weight: 600;
    color: #2563eb;
    background: #eff6ff;
    border: 1px solid #bfdbfe;
    padding: 2px 6px;
    border-radius: 4px;
    margin-bottom: 8px;
  }

  .ap-bulk-tag-hint button {
    color: #1d4ed8;
    font-weight: 800;
    text-decoration: underline;
    font-size: inherit;
  }

  .ap-item-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    margin-top: 4px;
  }

  .ap-item-counter {
    display: inline-flex;
    align-items: center;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    overflow: hidden;
    height: 28px;
    background: #ffffff;
  }

  .ap-item-counter button {
    background: #f8fafc;
    width: 26px;
    height: 100%;
    font-weight: 700;
    color: #334155;
    font-size: 14px;
  }

  .ap-item-counter button:hover {
    background: #e2e8f0;
  }

  .ap-item-counter span {
    padding: 0 8px;
    font-size: 12px;
    font-weight: 700;
  }

  .ap-item-remove-btn {
    color: #94a3b8;
    display: flex;
    padding: 4px;
    border-radius: 6px;
    font-size: 16px;
  }

  .ap-item-remove-btn:hover {
    color: #ef4444;
    background: #fee2e2;
  }

  .ap-drawer-footer {
    padding: 20px;
    border-top: 1px solid #e2e8f0;
  }

  .ap-subtotal-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 6px;
  }

  .ap-subtotal-label {
    font-size: 14px;
    color: #64748b;
    font-weight: 500;
  }

  .ap-subtotal-val {
    font-size: 20px;
    font-weight: 800;
  }

  .ap-shipping-note {
    font-size: 12px;
    color: #94a3b8;
    text-align: center;
    margin-bottom: 14px;
  }

  .ap-checkout-btn {
    display: block;
    width: 100%;
    background: #2563eb;
    color: #ffffff;
    text-align: center;
    padding: 14px;
    border-radius: 999px;
    font-size: 15px;
    font-weight: 700;
    box-shadow: 0 4px 12px rgba(37, 99, 235, 0.3);
  }

  .ap-checkout-btn:hover {
    background: #1d4ed8;
  }

</style>

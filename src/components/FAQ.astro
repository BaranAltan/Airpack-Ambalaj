---
interface Props {
  items: { question: string; answer: string }[];
}

const { items } = Astro.props;
---

<div class="faq">
  {
    items.map((item) => (
      <details name="sss">
        <summary>
          <h3>{item.question}</h3>
          <span class="plus" aria-hidden="true" />
        </summary>
        <p>{item.answer}</p>
      </details>
    ))
  }
</div>

<style>
  .faq {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 780px;
    margin: 0 auto;
  }

  details {
    background-color: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    transition:
      border-color var(--transition-normal),
      box-shadow var(--transition-normal);
  }

  details[open] {
    border-color: var(--primary-light);
    box-shadow: var(--shadow-md);
  }

  summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 20px;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary h3 {
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.6;
    margin: 0;
  }

  details[open] summary h3,
  summary:hover h3 {
    color: var(--primary);
  }

  .plus {
    position: relative;
    width: 12px;
    height: 12px;
    flex-shrink: 0;
    color: var(--text-muted);
  }

  .plus::before,
  .plus::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 12px;
    height: 1.5px;
    background: currentColor;
    transform: translate(-50%, -50%);
    transition: transform var(--transition-normal);
  }

  .plus::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }

  details[open] .plus {
    color: var(--primary);
  }

  details[open] .plus::after {
    transform: translate(-50%, -50%) rotate(0deg);
  }

  details p {
    padding: 0 20px 20px;
    margin: 0;
    line-height: 1.8;
  }
</style>

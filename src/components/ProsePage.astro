---
// Metin ağırlıklı sayfalar (yasal metinler, rehberler, SSS) için ortak şablon:
// sayfa başlığı + okunaklı metin alanı. "after" slotu metin kutusunun altına eklenir.
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from './PageHero.astro';

interface Props {
  /** Sayfadaki H1 */
  title: string;
  /** <title> (yoksa H1 kullanılır) */
  seoTitle?: string;
  description: string;
  badge: string;
  lead?: string;
  jsonLd?: Record<string, unknown>[];
  /** Paylaşım görseli yolu (/og/….jpg) */
  og?: string;
}

const { title, seoTitle = title, description, badge, lead, jsonLd = [], og } = Astro.props;
---

<BaseLayout title={seoTitle} description={description} jsonLd={jsonLd} og={og} imageAlt={og ? title : undefined}>
  <PageHero badge={badge} title={title} lead={lead} />
  <div class="container prose-wrap">
    <article class="glass-panel prose">
      <slot />
    </article>
    <slot name="after" />
  </div>
</BaseLayout>

<style>
  .prose-wrap {
    max-width: 880px;
    padding-top: 3rem;
    padding-bottom: 6rem;
  }

  .prose {
    padding: 2.5rem;
    color: #334155;
    font-size: 0.95rem;
    line-height: 1.75;
  }

  .prose :global(h2) {
    font-size: 1.25rem;
    color: var(--text-main);
    margin: 2rem 0 0.75rem;
  }

  .prose :global(h2:first-child) {
    margin-top: 0;
  }

  .prose :global(h3) {
    font-size: 1.02rem;
    color: var(--text-main);
    margin: 1.25rem 0 0.5rem;
  }

  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol),
  .prose :global(table) {
    margin-bottom: 0.9rem;
  }

  .prose :global(ul) {
    list-style: disc;
    padding-left: 1.25rem;
  }

  .prose :global(ol) {
    list-style: decimal;
    padding-left: 1.25rem;
  }

  .prose :global(li) {
    margin-bottom: 0.35rem;
  }

  .prose :global(a) {
    color: var(--primary);
    font-weight: 600;
  }

  .prose :global(a:hover) {
    text-decoration: underline;
  }

  .prose :global(strong) {
    color: var(--text-main);
  }

  .prose :global(.answer) {
    padding: 1rem 1.25rem;
    border-left: 4px solid var(--primary);
    border-radius: 0 12px 12px 0;
    background: #eff6ff;
    color: #1e3a8a;
  }

  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
  }

  .prose :global(th),
  .prose :global(td) {
    padding: 0.6rem 0.75rem;
    border: 1px solid var(--border-color);
    text-align: left;
    vertical-align: top;
  }

  .prose :global(th) {
    background: #f8fafc;
    color: var(--text-main);
  }

  .prose :global(.table-scroll) {
    overflow-x: auto;
  }

  .prose :global(dl) {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 0.35rem 1.25rem;
    padding: 1rem 1.25rem;
    margin-bottom: 1rem;
    border: 1px solid var(--border-color);
    border-radius: 12px;
    background: #fff;
  }

  .prose :global(dt) {
    font-weight: 600;
    color: var(--text-main);
  }

  @media (max-width: 600px) {
    .prose {
      padding: 1.5rem 1.25rem;
    }

    .prose :global(dl) {
      grid-template-columns: 1fr;
    }

    .prose :global(dd) {
      margin-bottom: 0.5rem;
    }
  }
</style>

export type IconName = keyof typeof stroke | keyof typeof fill;

interface Props {
  name: IconName;
  class?: string;
  label?: string;
  [attr: string]: unknown;
}

// ...attrs: ebeveyn bileşenin scoped-style attribute'u (data-astro-cid-*) SVG'ye aktarılır.
const { name, class: className, label, ...attrs } = Astro.props;
const isFill = name in fill;
const body = isFill ? fill[name as keyof typeof fill] : stroke[name as keyof typeof stroke];
---

<svg
  {...attrs}
  class:list={['icon', className]}
  viewBox="0 0 24 24"
  fill={isFill ? 'currentColor' : 'none'}
  stroke={isFill ? undefined : 'currentColor'}
  stroke-width={isFill ? undefined : 2}
  stroke-linecap={isFill ? undefined : 'round'}
  stroke-linejoin={isFill ? undefined : 'round'}
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  focusable="false"
  set:html={body}
/>

---
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import { Font, getImage } from 'astro:assets';
import logo from '../assets/site/logo.png';
import CartDrawer from '../components/CartDrawer.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { SITE } from '../data/site';
import { OG_HEIGHT, OG_WIDTH, ogPath } from '../lib/og';
import { organizationLd, websiteLd } from '../lib/seo';

interface Props {
  /** Sayfa başlığı; sonuna " - Airpack Ambalaj" eklenir. */
  title: string;
  description?: string;
  /** Paylaşım görseli olarak kırpılacak görsel (og verilmediğinde) */
  image?: ImageMetadata;
  /** Derlemede üretilen 1200×630 paylaşım görseli yolu (/og/….jpg). image ve og yoksa site görseli kullanılır. */
  og?: string;
  imageAlt?: string;
  noindex?: boolean;
  ogType?: 'website' | 'product';
  /** Sayfaya özel JSON-LD düğümleri (@graph içine eklenir). */
  jsonLd?: Record<string, unknown>[];
  /** Sayfalı listelerde önceki/sonraki sayfa bağlantıları */
  prev?: string;
  next?: string;
}

const {
  title,
  description = SITE.description,
  image,
  og,
  imageAlt = 'Airpack Ambalaj: hava kanallı ambalaj ve airpack poşet',
  noindex = false,
  ogType = 'website',
  jsonLd = [],
  prev,
  next,
} = Astro.props;

const fullTitle = `${title} - ${SITE.name}`;
const canonical = new URL(Astro.url.pathname.replace(/\/?$/, '/'), Astro.site).href;

// Paylaşım görseli: hazır 1200×630 görsel (og) ya da verilen görselden kırpım. 1,91:1 oranı korunur;
// Astro küçük görseli büyütmediği için kırpım kaynağın sığdığı boyutta üretilir.
let ogUrl = new URL(og ?? ogPath('site'), Astro.site).href;
let ogWidth = OG_WIDTH;
let ogHeight = OG_HEIGHT;
if (image && !og) {
  ogWidth = Math.min(OG_WIDTH, image.width);
  ogHeight = Math.round((ogWidth * OG_HEIGHT) / OG_WIDTH);
  const cropped = await getImage({ src: image, width: ogWidth, height: ogHeight, fit: 'cover', format: 'jpg', quality: 82 });
  ogUrl = new URL(cropped.src, Astro.site).href;
}
const logoImg = await getImage({ src: logo, width: 600, format: 'webp' });

const graph = {
  '@context': 'https://schema.org',
  '@graph': [organizationLd(Astro.site, new URL(logoImg.src, Astro.site).href), websiteLd(Astro.site), ...jsonLd],
};

---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Google Tag Manager -->
    <script is:inline>
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
      new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
      'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer','GTM-WD2X4WR4');
    </script>
    <!-- End Google Tag Manager -->

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={noindex ? 'noindex, follow' : 'index, follow, max-snippet:-1, max-video-preview:-1, max-image-preview:large'}
    />
    {!noindex && <link rel="canonical" href={canonical} />}
    {prev && <link rel="prev" href={new URL(prev, Astro.site).href} />}
    {next && <link rel="next" href={new URL(next, Astro.site).href} />}

    <Font cssVariable="--font-inter" preload />

    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/icon-192.png" sizes="192x192" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#2563eb" />
    <meta name="google-site-verification" content="fNfxe8Q4ChsxkVRLsUCpek3hG-CaeXlvsMRLsxfw3Zc" />

    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="tr_TR" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content={String(ogWidth)} />
    <meta property="og:image:height" content={String(ogHeight)} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(graph)} />

    <!-- Bağlantıların üzerine gelindiğinde sayfayı önceden yükler (Chromium); JS paketi gerektirmez. -->
    <script type="speculationrules" is:inline>
      {
        "prefetch": [
          {
            "source": "document",
            "where": { "and": [{ "href_matches": "/*" }, { "not": { "href_matches": "/odeme/*" } }, { "not": { "href_matches": "/sepet/*" } }] },
            "eagerness": "moderate"
          }
        ]
      }
    </script>
    <slot name="head" />
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-WD2X4WR4"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <a class="skip-link" href="#icerik">İçeriğe geç</a>
    <Header />
    <main id="icerik">
      <slot />
    </main>
    <Footer />
    <CartDrawer />
    <WhatsAppButton />
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: 1rem;
    top: -100px;
    z-index: 3001;
    padding: 0.6rem 1rem;
    border-radius: 8px;
    background: var(--primary);
    color: #fff;
    font-weight: 600;
  }

  .skip-link:focus {
    top: 0.75rem;
  }
</style>

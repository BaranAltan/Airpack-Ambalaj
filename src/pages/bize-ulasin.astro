---
import Icon from '../components/Icon.astro';
import PageHero from '../components/PageHero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, whatsappLink } from '../data/site';
import { breadcrumbLd } from '../lib/seo';
---

<BaseLayout
  title="İletişim ve Toptan Sipariş"
  description={`Airpack Ambalaj iletişim: özel ebat ölçüleri, toptan sipariş ve numune talepleriniz için ${SITE.phone} numaralı telefon ve WhatsApp hattımızdan bize ulaşın.`}
  jsonLd={[
    breadcrumbLd([{ name: 'Ana Sayfa', path: '/' }, { name: 'Bize Ulaşın', path: '/bize-ulasin/' }], Astro.site),
    { '@type': 'ContactPage', name: 'Bize Ulaşın', url: new URL('/bize-ulasin/', Astro.site).href },
  ]}
>
  <PageHero
    badge="7/24 Kesintisiz Destek & Danışmanlık"
    title="İletişim"
    lead="Özel ebat ölçüleri, toptan sipariş talepleriniz veya tüm sorularınız için bizimle iletişime geçebilirsiniz."
  />

  <section class="contact-section">
    <div class="container grid">
      <div class="cards">
        <a class="info glass-panel" href={whatsappLink()} target="_blank" rel="noopener">
          <span class="i-icon"><Icon name="phone" /></span>
          <div>
            <h2>Telefon & WhatsApp</h2>
            <p>{SITE.phone}</p>
          </div>
        </a>
        <a class="info glass-panel" href={`mailto:${SITE.email}`}>
          <span class="i-icon"><Icon name="mail" /></span>
          <div>
            <h2>E-Posta</h2>
            <p>{SITE.email}</p>
          </div>
        </a>
        <div class="info glass-panel">
          <span class="i-icon"><Icon name="map-pin" /></span>
          <div>
            <h2>Üretim Tesisi Adresi</h2>
            <p>{SITE.address.city} / {SITE.address.district}</p>
          </div>
        </div>
      </div>

      <form class="form glass-panel" id="contact-form" action={whatsappLink()} method="get" target="_blank">
        <div class="field">
          <label for="c-name">Ad Soyad / Firma *</label>
          <input class="input" id="c-name" required autocomplete="name" placeholder="Adınız" />
        </div>
        <div class="field">
          <label for="c-phone">Telefon *</label>
          <input class="input" id="c-phone" type="tel" required autocomplete="tel" placeholder="Telefon Numaranız" />
        </div>
        <div class="field">
          <label for="c-email">E-posta</label>
          <input class="input" id="c-email" type="email" autocomplete="email" placeholder="E-Posta Adresiniz" />
        </div>
        <div class="field">
          <label for="c-message">Mesajınız / Talebiniz *</label>
          <textarea class="input" id="c-message" name="text" rows="4" required placeholder="Mesajınız"></textarea>
        </div>
        <button type="submit" class="btn btn-primary btn-block">Gönder</button>
        <p class="note">Mesajınız WhatsApp hattımıza iletilir; en kısa sürede dönüş yapıyoruz.</p>
      </form>
    </div>
  </section>
</BaseLayout>

<script>
  import { whatsappLink } from '../data/site';

  const form = document.getElementById('contact-form') as HTMLFormElement;
  const val = (id: string) => (document.getElementById(id) as HTMLInputElement).value.trim();

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const email = val('c-email');
    const message = [
      'Merhaba, web sitenizden yazıyorum.',
      '',
      `Ad / Firma: ${val('c-name')}`,
      `Telefon: ${val('c-phone')}`,
      ...(email ? [`E-posta: ${email}`] : []),
      '',
      val('c-message'),
    ].join('\n');
    const w = window as Window & { dataLayer?: unknown[] };
    w.dataLayer = w.dataLayer || [];
    w.dataLayer.push({ event: 'custom_form_sent', site_name: location.hostname.replace(/^www\./, '') });
    window.open(whatsappLink(message), '_blank', 'noopener');
  });
</script>

<style>
  .contact-section {
    padding: 100px 0;
  }

  .grid {
    display: grid;
    grid-template-columns: minmax(0, 0.67fr) minmax(0, 1fr);
    gap: 50px;
    align-items: start;
  }

  .cards {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .info {
    display: flex;
    gap: 1.25rem;
    padding: 1.5rem;
    border-radius: 16px;
    background: #fff;
    transition: transform var(--transition-fast);
  }

  a.info:hover {
    transform: translateY(-2px);
  }

  .i-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    flex-shrink: 0;
    border-radius: 12px;
    background-color: #dbeafe;
    color: var(--primary);
    font-size: 1.2rem;
  }

  .info h2 {
    font-size: 1rem;
    margin-bottom: 0.25rem;
  }

  .info p {
    margin: 0;
    font-size: 0.9rem;
  }

  .form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 2.5rem 3rem;
    border-radius: 16px;
    background: #fff;
  }

  .form .input {
    padding: 8px 12px;
    font-size: 0.875rem;
    background: #fff;
    border-radius: 6px;
  }

  .form .btn {
    margin-top: 0.5rem;
  }

  .note {
    margin: 0;
    font-size: 0.8rem;
    text-align: center;
  }

  @media (max-width: 860px) {
    .contact-section {
      padding: 48px 0;
    }

    .grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .form {
      padding: 1.5rem;
    }
  }
</style>

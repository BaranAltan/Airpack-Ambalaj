---
import Icon from '../components/Icon.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { iller } from '../data/iller';
import { SITE } from '../data/site';
---

<BaseLayout title="Ödeme" description="Airpack Ambalaj sipariş formu." noindex>
  <section class="checkout">
    <div class="container">
      <div class="empty" data-empty hidden>
        <h1>Sepetiniz Boş</h1>
        <p>Ödeme sayfasına ilerleyebilmek için sepetinizde ürün bulunmalıdır.</p>
        <a href="/magaza/" class="btn btn-primary">Alışverişe Devam Et</a>
      </div>

      <div data-filled>
        <a href="/sepet/" class="back"><Icon name="arrow-left" /> Sepete Dön</a>
        <h1>Siparişi Tamamla</h1>

        <div class="grid">
          <form class="card" id="checkout-form">
            <h2><Icon name="map-pin" /> Fatura ve Teslimat Bilgileri</h2>
            <div class="row2">
              <div class="field">
                <label for="f-name">Ad Soyad *</label>
                <input class="input" id="f-name" name="name" required autocomplete="name" placeholder="Adınız Soyadınız" />
              </div>
              <div class="field">
                <label for="f-company">Firma Adı (Kurumsal)</label>
                <input class="input" id="f-company" name="company" autocomplete="organization" placeholder="Firma Adı" />
              </div>
              <div class="field">
                <label for="f-taxOffice">Vergi Dairesi (Opsiyonel)</label>
                <input class="input" id="f-taxOffice" name="taxOffice" placeholder="Vergi Dairesi" />
              </div>
              <div class="field">
                <label for="f-taxNumber">Vergi No (Opsiyonel)</label>
                <input class="input" id="f-taxNumber" name="taxNumber" inputmode="numeric" placeholder="Vergi No" />
              </div>
              <div class="field">
                <label for="f-phone">Telefon *</label>
                <input class="input" id="f-phone" name="phone" type="tel" required autocomplete="tel" placeholder="05XX XXX XX XX" />
              </div>
              <div class="field">
                <label for="f-email">E-Posta *</label>
                <input class="input" id="f-email" name="email" type="email" required autocomplete="email" placeholder="ornek@sirket.com" />
              </div>
            </div>
            <div class="field">
              <label for="f-address">Açık Adres (Mahalle & Sokak) *</label>
              <textarea class="input" id="f-address" name="address" required autocomplete="street-address" placeholder="Mahalle, Cadde, Sokak, Bina No, Daire..."></textarea>
            </div>
            <div class="row2">
              <div class="field">
                <label for="f-city">Şehir *</label>
                <select class="input" id="f-city" name="city" required autocomplete="address-level1">
                  {iller.map((il) => <option selected={il === 'İstanbul'}>{il}</option>)}
                </select>
              </div>
              <div class="field">
                <label for="f-district">İlçe / Semt *</label>
                <input class="input" id="f-district" name="district" required autocomplete="address-level2" placeholder="İlçe adı yazınız" />
              </div>
            </div>
            <label class="consent">
              <input type="checkbox" name="consent" required />
              <span>
                <a href="/mesafeli-satis-sozlesmesi/" target="_blank">Ön bilgilendirme formunu ve mesafeli satış sözleşmesini</a> okudum, kabul ediyorum. Kişisel verilerim <a href="/kvkk-aydinlatma-metni/" target="_blank">KVKK aydınlatma metni</a> kapsamında işlenir.
              </span>
            </label>
          </form>

          <aside class="card summary" aria-labelledby="sum-title">
            <h2 id="sum-title">Sipariş Özeti</h2>
            <ul class="items" data-items></ul>
            <div class="rows">
              <div><span>Ara Toplam</span><span data-subtotal></span></div>
              <div><span>Kargo Tutarı</span><span data-shipping></span></div>
            </div>
            <div class="grand">
              <span>Genel Toplam</span>
              <strong data-total></strong>
            </div>
            <div class="info">
              <Icon name="check-circle" />
              <p>{SITE.paymentNote}</p>
            </div>
            <button type="submit" form="checkout-form" class="btn btn-primary btn-block submit">Siparişi Onayla</button>
          </aside>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { formatNumber, formatQuantity, formatTRY } from '../lib/pricing';
  import { whatsappLink } from '../data/site';
  import { cart, lineTotal, lineUnitPrice, unitOf } from '../scripts/cart';

  const $ = (sel: string) => document.querySelector<HTMLElement>(sel)!;
  const form = document.getElementById('checkout-form') as HTMLFormElement;
  let submitted = false;

  const render = () => {
    if (submitted) return;
    const has = cart.items().length > 0;
    $('[data-empty]').hidden = has;
    $('[data-filled]').hidden = !has;
    if (!has) return;
    $('[data-items]').replaceChildren(
      ...cart.items().map((i) => {
        const li = document.createElement('li');
        const name = document.createElement('span');
        name.textContent = unitOf(i) === 'metre' ? `${formatQuantity(i.quantity, 'metre')} × ${i.name}` : `${formatNumber(i.quantity)}× ${i.name}`;
        const price = document.createElement('strong');
        price.textContent = formatTRY(lineTotal(i));
        li.append(name, price);
        return li;
      }),
    );
    const { subtotal, shipping, total } = cart.totals();
    $('[data-subtotal]').textContent = formatTRY(subtotal);
    $('[data-shipping]').textContent = shipping === 0 ? 'Ücretsiz' : formatTRY(shipping);
    $('.summary [data-total]').textContent = formatTRY(total);
  };
  render();
  cart.onChange(render);

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const items = cart.items();
    if (!items.length) return;
    const d = Object.fromEntries(new FormData(form)) as Record<string, string>;
    const { subtotal, shipping, total } = cart.totals();
    const now = new Date();
    const orderNo = `AP${now.toISOString().slice(2, 10).replaceAll('-', '')}${Math.floor(100 + Math.random() * 900)}`;
    const date = now.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long', year: 'numeric' });

    // Yalnızca düz metin: emoji (bazı WhatsApp sürümlerinde "�" olarak görünüyor), * ve ₺ kullanılmaz.
    const tl = (n: number) => `${n.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 })} TL`;
    const lines = [
      'Merhaba, web sitenizden sipariş oluşturdum. IBAN bilgisini rica ederim.',
      '',
      `Sipariş No: ${orderNo}`,
      `Tarih: ${date}`,
      `Müşteri: ${d.name}${d.company ? ` (${d.company})` : ''}`,
      ...(d.taxOffice || d.taxNumber ? [`Vergi: ${[d.taxOffice, d.taxNumber].filter(Boolean).join(' / ')}`] : []),
      `Telefon: ${d.phone}`,
      `E-posta: ${d.email}`,
      `Adres: ${d.address}, ${d.district} / ${d.city}`,
      '',
      'Sipariş Detayları:',
      ...items.map((i) => {
        const unit = unitOf(i);
        const qty = unit === 'metre' ? `${formatNumber(i.quantity)} metre` : `${formatNumber(i.quantity)} adet`;
        const name = i.name.replace(/×/g, 'x').replace(/’/g, "'");
        return `- ${name}: ${qty} (${tl(lineUnitPrice(i))}/${unit} = ${tl(lineTotal(i))})`;
      }),
      '',
      `Ara Toplam: ${tl(subtotal)}`,
      `Kargo: ${shipping === 0 ? 'Ücretsiz' : tl(shipping)}`,
      `Genel Toplam: ${tl(total)}`,
      'Ödeme: Havale / EFT',
    ];
    const waUrl = whatsappLink(lines.join('\n'));

    try {
      sessionStorage.setItem(
        'airpack-last-order',
        JSON.stringify({
          orderNo,
          date,
          waUrl,
          customer: d,
          items: items.map((i) => ({ slug: i.slug, name: i.name, quantity: i.quantity, unit: unitOf(i), total: lineTotal(i) })),
          subtotal,
          shipping,
          total,
        }),
      );
    } catch {
      /* depolama kapalı */
    }

    submitted = true;
    window.open(waUrl, '_blank', 'noopener');
    cart.clear();
    location.href = '/siparis-ozeti/';
  });
</script>

<style>
  .checkout {
    padding: 2rem 0 4rem;
    background-color: var(--bg-color);
    min-height: 70vh;
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  .back:hover {
    color: var(--primary);
  }

  h1 {
    font-size: 2.5rem;
    margin: 1.5rem 0 2rem;
  }

  .empty {
    text-align: center;
    padding: 4rem 1rem;
  }

  .empty h1 {
    font-size: 1.5rem;
    margin: 0 0 1rem;
  }

  .grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 2rem;
    align-items: start;
  }

  .card {
    background-color: #fff;
    border-radius: 16px;
    padding: 2rem;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
  }

  form.card {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .card h2 {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.25rem;
    margin: 0;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border-color);
  }

  .card h2 .icon {
    color: var(--primary);
  }

  .row2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  .field label {
    font-weight: 500;
  }

  .consent {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    margin-top: 1.25rem;
    font-size: 0.85rem;
    color: var(--text-muted);
    cursor: pointer;
  }

  .consent input {
    flex-shrink: 0;
    width: 18px;
    height: 18px;
    margin-top: 0.15rem;
    accent-color: var(--primary);
  }

  .consent a {
    color: var(--primary);
    font-weight: 600;
  }

  .summary {
    position: sticky;
    top: calc(var(--header-height) + 2rem);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .items {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    max-height: 250px;
    overflow-y: auto;
    font-size: 0.9rem;
  }

  .items :global(li) {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }

  .items :global(span) {
    color: var(--text-muted);
  }

  .rows {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    border-top: 1px solid var(--border-color);
    padding-top: 1.25rem;
    color: var(--text-muted);
  }

  .rows > div {
    display: flex;
    justify-content: space-between;
  }

  .rows span:last-child {
    color: var(--text-main);
    font-weight: 600;
  }

  .grand {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid var(--border-color);
    padding-top: 1.25rem;
    font-size: 1.1rem;
    font-weight: 600;
  }

  .grand strong {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--primary);
  }

  .info {
    display: flex;
    gap: 0.6rem;
    padding: 1rem;
    border-radius: 12px;
    background: #eff6ff;
    border: 1px solid #bfdbfe;
  }

  .info .icon {
    color: var(--primary);
    font-size: 1.1rem;
    margin-top: 0.15rem;
  }

  .info p {
    margin: 0;
    font-size: 0.82rem;
    color: #1e40af;
  }

  .submit {
    padding: 1rem;
    font-size: 1.05rem;
  }

  @media (max-width: 992px) {
    .grid {
      grid-template-columns: 1fr;
    }

    .summary {
      position: static;
    }
  }

  @media (max-width: 640px) {
    h1 {
      font-size: 2rem;
    }

    .card {
      padding: 1.25rem;
    }

    .row2 {
      grid-template-columns: 1fr;
    }
  }
</style>
